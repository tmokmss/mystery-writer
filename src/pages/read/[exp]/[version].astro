---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { allDocs, url, pagePath, titleOf, draftsOf } from '../../../lib/docs';

export async function getStaticPaths() {
  const docs = await allDocs();
  const ids = docs.map((d) => d.id);
  const byId = new Map(docs.map((d) => [d.id, d]));
  return docs
    .filter((d) => /^experiments\/[^/]+\/README$/.test(d.id))
    .flatMap((readme) => {
      const dir = readme.id.replace(/\/README$/, '');
      const exp = dir.replace(/^experiments\//, '');
      const drafts = draftsOf(dir, ids).filter((v) => v.problem && v.solution);
      return drafts.map((d, i) => ({
        params: { exp, version: d.version },
        props: {
          readme,
          problem: byId.get(d.problem!)!,
          solution: byId.get(d.solution!)!,
          prev: drafts[i - 1]?.version,
          next: drafts[i + 1]?.version,
        },
      }));
    });
}

const { exp, version } = Astro.params;
const { readme, problem, solution, prev, next } = Astro.props;
const { Content: Problem } = await render(problem);
const { Content: Solution } = await render(solution);
const title = titleOf(problem.body, version);
const crumbs = [
  { label: 'トップ', href: url('') },
  { label: exp, href: url(pagePath(readme.id)) },
];
---
<Base title={`${title}（${version}）`} crumbs={crumbs}>
  <p class="eyebrow">{titleOf(readme.body, exp)} ／ {version}</p>
  <article class="story">
    <Problem />
  </article>
  <details class="solution">
    <summary>解決編を開く</summary>
    <article class="story">
      <Solution />
    </article>
  </details>
  <nav class="versions">
    {prev ? <a href={url(`read/${exp}/${prev}.html`)}>← {prev}</a> : <span />}
    <a href={url(pagePath(readme.id))}>実験の結論と結果</a>
    {next ? <a href={url(`read/${exp}/${next}.html`)}>{next} →</a> : <span />}
  </nav>
</Base>

<style>
  .story { font-family: var(--serif); }
  .story :global(h1) { font-size: clamp(2.2rem, 9vw, 3.4rem); font-weight: 800; letter-spacing: .08em; margin: .2rem 0 2rem; }
  .story :global(h2) { font-size: 1.05rem; font-weight: 600; color: var(--accent); letter-spacing: .3em; margin: 2.6rem 0 1.2rem; }
  .story :global(p) { font-size: 1.06rem; line-height: 2.05; margin: 0 0 1.1em; text-indent: 1em; overflow-wrap: anywhere; }
  .story :global(p:has(> strong:only-child)) { text-indent: 0; color: var(--lamp); font-family: var(--sans); font-size: .9rem; letter-spacing: .1em; margin-top: 2.5rem; }
  .story :global(ul) { font-family: var(--sans); font-size: .92rem; line-height: 1.9; background: var(--paper); border: 1px solid var(--rule); padding: 1rem 1rem 1rem 2rem; }
  .story :global(table) { font-family: var(--sans); }
  .story :global(img) { display: block; max-width: 100%; height: auto; margin: 1.6rem auto; }
  .story :global(p:has(> img:only-child)) { text-indent: 0; }
  .story :global(hr) { border: 0; border-top: 1px solid var(--rule); margin: 2rem 0; }
  .solution { margin-top: 2.5rem; border-top: 1px solid var(--rule); padding-top: .8rem; }
  .solution summary { cursor: pointer; color: var(--accent); font-weight: 500; padding: .6rem 0; }
  .versions { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--rule); font-size: .9rem; }
</style>
