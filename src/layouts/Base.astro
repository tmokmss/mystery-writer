---
import { url } from '../lib/docs';

interface Props {
  title: string;
  crumbs?: { label: string; href: string }[];
  wide?: boolean;
}
const { title, crumbs = [], wide = false } = Astro.props;
const siteName = 'mystery-writer';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title === siteName ? siteName : `${title} | ${siteName}`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;600;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <header class="top">
      <div class="bar">
        <a class="brand" href={url('')}>mystery-writer</a>
        <nav>
          <a href="https://github.com/tmokmss/mystery-writer">GitHub</a>
        </nav>
      </div>
    </header>
    <main class:list={['page', { wide }]}>
      {
        crumbs.length > 0 && (
          <ol class="crumbs">
            {crumbs.map((c) => (
              <li><a href={c.href}>{c.label}</a></li>
            ))}
          </ol>
        )
      }
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* layout: a single reading column under a thin top bar; tables scroll inside their own box */
  :root {
    --bg: #eef1f2;
    --paper: #f8fafa;
    --ink: #1d2a30;
    --muted: #5b6b72;
    --rule: #cbd5d8;
    --accent: #2f6f73;
    --lamp: #a5621c;
    --serif: 'Shippori Mincho', 'Hiragino Mincho ProN', 'Yu Mincho', serif;
    --sans: 'Zen Kaku Gothic New', 'Hiragino Sans', 'Yu Gothic', system-ui, sans-serif;
    --mono: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #10181c; --paper: #162127; --ink: #dfe7ea; --muted: #93a4ab;
      --rule: #2c3b42; --accent: #7fbfc2; --lamp: #e0a35c; color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #10181c; --paper: #162127; --ink: #dfe7ea; --muted: #93a4ab;
    --rule: #2c3b42; --accent: #7fbfc2; --lamp: #e0a35c; color-scheme: dark;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--sans); line-height: 1.8; }
  a { color: var(--accent); }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .top { border-bottom: 1px solid var(--rule); background: var(--paper); }
  .bar {
    max-width: 52rem; margin: 0 auto; display: flex; gap: 1rem; align-items: center; justify-content: space-between;
    padding-block: .7rem; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px));
  }
  .brand { font-family: var(--serif); font-weight: 800; font-size: 1.1rem; color: var(--ink); text-decoration: none; letter-spacing: .04em; }
  .bar nav { display: flex; gap: 1rem; font-size: .9rem; }
  .bar nav a { color: var(--muted); text-decoration: none; }
  .bar nav a:hover { color: var(--accent); }
  .page {
    max-width: 44rem; margin: 0 auto; padding-block: 2rem 4rem;
    padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px));
  }
  .page.wide { max-width: 52rem; }
  .crumbs { list-style: none; padding: 0; margin: 0 0 1.5rem; display: flex; flex-wrap: wrap; gap: .3rem; font-size: .8rem; color: var(--muted); }
  .crumbs li + li::before { content: '/'; margin-right: .3rem; color: var(--rule); }
  .crumbs a { color: var(--muted); }
  .prose { min-width: 0; }
  .prose h1 { font-family: var(--serif); font-size: clamp(1.6rem, 5vw, 2.2rem); line-height: 1.4; text-wrap: balance; margin: 0 0 1rem; }
  .prose h2 { font-family: var(--serif); font-size: 1.35rem; margin: 2.4rem 0 .8rem; padding-bottom: .3rem; border-bottom: 1px solid var(--rule); text-wrap: balance; }
  .prose h3 { font-size: 1.05rem; margin: 1.8rem 0 .6rem; }
  .prose p, .prose li { overflow-wrap: anywhere; }
  .prose li { margin: .25rem 0; }
  .prose code { font-family: var(--mono); font-size: .88em; background: var(--paper); border: 1px solid var(--rule); border-radius: 4px; padding: 0 .3em; }
  .prose pre { background: var(--paper); border: 1px solid var(--rule); padding: .8rem 1rem; overflow-x: auto; border-radius: 6px; }
  .prose pre code { border: 0; padding: 0; background: none; }
  .prose blockquote { margin: 1rem 0; padding: .2rem 1rem; border-left: 3px solid var(--rule); color: var(--muted); }
  .prose hr { border: 0; border-top: 1px solid var(--rule); margin: 2rem 0; }
  .table-wrap { overflow-x: auto; margin: 1rem 0; }
  .prose table { display: block; max-width: 100%; overflow-x: auto; }
  table { border-collapse: collapse; font-size: .88rem; font-variant-numeric: tabular-nums; }
  th, td { border-bottom: 1px solid var(--rule); padding: .45rem .6rem; text-align: left; vertical-align: top; }
  th { font-weight: 700; color: var(--muted); font-size: .8rem; letter-spacing: .04em; white-space: nowrap; }
  .eyebrow { font-size: .75rem; letter-spacing: .12em; color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; } }
</style>
